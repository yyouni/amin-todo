# Generate local secrets with: npm run setup:env
POSTGRES_USER=todo
POSTGRES_DB=todo
POSTGRES_PASSWORD=replace-with-random-hex
SESSION_SECRET=replace-with-at-least-32-random-characters
GRAFANA_DB_PASSWORD=replace-with-random-hex
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-hex
# For npm run dev (PostgreSQL bound to localhost via compose.dev.yml):
DATABASE_URL=postgres://todo:replace-with-random-hex@127.0.0.1:15432/todo
POSTGRES_PORT=15432
# Docker: localhost:8080. For VPS set http://YOUR_IP and WEB_PORT=80.
# For npm run dev set http://localhost:5173.
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false
TRUST_PROXY=false
PORT=3001
# Production: ghcr.io/owner/repository (lowercase), commit SHA.
IMAGE_PREFIX=todo
IMAGE_TAG=local

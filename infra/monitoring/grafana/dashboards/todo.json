    {
      "id": 17,
      "title": "Посещения по часам",
      "description": "Каждая полная загрузка/перезагрузка страницы. UTC в БД, отображение Asia/Yekaterinburg. Текущий час еще неполный.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "visits"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT h AS time, coalesce(p.views, 0) AS \"Посещения\" FROM generate_series(date_trunc('hour', $__timeFrom()::timestamptz, 'UTC'), date_trunc('hour', $__timeTo()::timestamptz, 'UTC'), interval '1 hour') h LEFT JOIN page_view_hours p ON p.hour = h ORDER BY h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
